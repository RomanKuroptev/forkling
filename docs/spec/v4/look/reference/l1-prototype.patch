+        vec2 ga = abs(fract(gp - 0.5) - 0.5) / max(gw, vec2(0.0001));
+        float gl = 1.0 - min(min(ga.x, ga.y) / 1.5, 1.0);
+        float gf = 1.0 - smoothstep(40.0, 220.0, length(vGridPos.xz - cameraPosition.xz));
+        diffuseColor.rgb = mix(diffuseColor.rgb, vec3(1.0, 0.42, 0.86), gl * gf * 0.75);
+      }`,
+    )
