rican.com/article/anth..."},"embed":{"external":{"uri":"https://www.scientificamerican.com/article/anthropic-mathematician-claims-to-prove-riemann-hypothesis-most-famous-problem-in-all-of-math/","title":"Anthropic mathematician claims to prove Riemann hypothesis, most famous problem in all of math","description":"An AI-generated solution of the 167-year-old problem, long considered far out of reach to human mathematicians, would cap off the technology’s year-long conquest of math in spectacular fashion","thumb":"https://cdn.bsky.app/img/feed_thumbnail/plain/did:plc:o72ypk5c474zqklkukaphuy3/bafkreiezgmjzn5sxlqqhknqbja3jaohwxnxiqmpbw6vpz4nfienqcvvvpy"},"$type":"app.bsky.embed.external#view"},"bookmarkCount":49,"replyCount":41,"repostCount":108,"likeCount":393,"quoteCount":90,"indexedAt":"2026-11-20T15:02:29.052Z","labels":[]},"opThreadPostIndex":1,"opThreadPostCount":3,"feedContext":"trending-posts","reqId":"2879854280653500685"},{"post":{"uri":"at://did:plc:x4rkbrazjqyyun5ysut2wq43/app.bsky.feed.post/3n2qzot7mnc2b","cid":"bafyreiapqscd3rnxrhjnlvfcjawp7u5zbazgb7ppp34u2frex74hktdpme","author":{"did":"did:plc:x4rkbrazjqyyun5ysut2wq43","handle":"pookleblinky.bsky.social","displayName":"Pookleblinky","pronouns":"Avoid pronouns","avatar":"https://cdn.bsky.app/img/avatar/plain/did:plc:x4rkbrazjqyyun5ysut2wq43/bafkreiguo72vawreirgsl7o6kkle3bduhub7g776kxozyughmnlxdgv73a","associated":{"chat":{"allowIncoming":"following"},"activitySubscription":{"allowSubscriptions":"followers"}},"labels":[{"src":"did:plc:x4rkbrazjqyyun5ysut2wq43","uri":"at://did:plc:x4rkbrazjqyyun5ysut2wq43/app.bsky.actor.profile/self","cid":"bafyreifygeh6wnpc6hssbixhvxyhpkiqizyqg6fugqpgipbilhqdq5vksi","val":"!no-unauthenticated","cts":"1970-01-01T00:00:00.000Z"}],"createdAt":"2023-09-04T02:56:42.474Z"},"record":{"$type":"app.bsky.feed.post","createdAt":"2026-11-20T16:41:14.257Z","embed":{"$type":"app.bsky.embed.record","record":{"cid":"bafyreiec5zdxqr6znptlp53uvmvd6bqk5wg4t62rz3v4dxnkc3sgacoela","uri":"at://did:plc:x4rkbrazjqyyun5ysut2wq43/app.bsky.feed.post/3mvnjhbxiuc2o"}},"langs":["en"],"text":"Even *if* today's proof of the Riemann Hypothesis is correct and not just exploiting a bug in Lean, there is the problem that the proof is 17 million lines of Lean that are not inside a human head bumping around with their lifetime of mathematical experience making unexpected babies."},"embed":{"record":{"uri":"at://did:plc:x4rkbrazjqyyun5ysut2wq43/app.bsky.feed.post/3mvnjhbxiuc2o","cid":"bafyreiec5zdxqr6znptlp53uvmvd6bqk5wg4t62rz3v4dxnkc3sgacoela","author":{"did":"did:plc:x4rkbrazjqyyun5ysut2wq43","handle":"pookleblinky.bsky.social","displayName":"Pookleblinky","pronouns":"Avoid pronouns","avatar":"https://cdn.bsky.app/img/avatar/plain/did:plc:x4rkbrazjqyyun5ysut2wq43/bafkreiguo72vawreirgsl7o6kkle3bduhub7g776kxozyughmnlxdgv73a","associated":{"chat":{"allowIncoming":"following"},"activitySubscription":{"allowSubscriptions":"followers"}},"labels":[{"src":"did:plc:x4rkbrazjqyyun5ysut2wq43","uri":"at://did:plc:x4rkbrazjqyyun5ysut2wq43/app.bsky.actor.profile/self","cid":"bafyreifygeh6wnpc6hssbixhvxyhpkiqizyqg6fugqpgipbilhqdq5vksi","val":"!no-unauthenticated","cts":"1970-01-01T00:00:00.000Z"}],"createdAt":"2023-09-04T02:56:42.474Z"},"value":{"$type":"app.bsky.feed.post","createdAt":"2026-09-16T16:06:44.061Z","embed":{"$type":"app.bsky.embed.record","record":{"cid":"bafyreieo2i7v3xsmrij4zpckxarjsg4jjulkdkziyqtmhm5fgggyecqkza","uri":"at://did:plc:x4rkbrazjqyyun5ysut2wq43/app.bsky.feed.post/3lqstrj6rkk2f"}},"langs":["en"],"text":"This is also why, as Terence Tao pointed out, genAI mathematics sucks: it removes every bit of unexpected consilience that comes from understanding the mental model and process.\n\n\"Oh shit, this could be used to think about this totally other thing\" is *how all mathematics grows*"},"labels":[],"likeCount":242,"replyCount":3,"repostCount":54,"quoteCount":3,"opThreadPostIndex":1,"opThreadPostCount":6,"indexedAt":"2026-09-16T16:06:44.259Z","embeds":[{"record":{"uri":"at://did:plc:x4rkbrazjqyyun5ysut2wq43/app.bsky.feed.post/3lqstrj6rkk2f","cid":"bafyreieo2i7v3xsmrij4zpckxarjsg4jjulkdkziyqtmhm5fgggyecqkza","author":{"did":"did:plc:x4rkbrazjqyyun5ysut2wq43","handle":"pookleblinky.bsky.social","displayName":"Pookleblinky","pronouns":"Avoid pronouns","avatar":"https://cdn.bsky.app/img/avatar/plain/did:plc:x4rkbrazjqyyun5ysut2wq43/bafkreiguo72vawreirgsl7o6kkle3bduhub7g776kxozyughmnlxdgv73a","associated":{"chat":{"allowIncoming":"following"},"activitySubscription":{"allowSubscriptions":"followers"}},"labels":[{"src":"did:plc:x4rkbrazjqyyun5ysut2wq43","uri":"at://did:plc:x4rkbrazjqyyun5ysut2wq43/app.bsky.actor.profile/self","cid":"bafyreifygeh6wnpc6hssbixhvxyhpkiqizyqg6fugqpgipbilhqdq5vksi","val":"!no-unauthenticated","cts":"1970-01-01T00:00:00.000Z"}],"createdAt":"2023-09-04T02:56:42.474Z"},"value":{"$type":"app.bsky.feed.post","createdAt":"2025-06-04T22:22:33.066Z","langs":["en"],"text":"The speed of writing code has never, and will never be the bottleneck.\n\nThe bottleneck, the limiting factor, is always in the thinking about the code and how it works, understanding it.\n\nPeople who use chatgpt to write code are literally removing the only part of programming that is actually useful."},"labels":[],"likeCount":2102,"replyCount":16,"repostCount":425,"quoteCount":59,"indexedAt":"2025-06-04T22:22:33.645Z","$type":"app.bsky.embed.record#viewRecord"},"$type":"app.bsky.embed.record#view"}],"$type":"app.bsky.embed.record#viewRecord"},"$type":"app.bsky.embed.record#view"},"bookmarkCount":7,"replyCount":3,"repostCount":29,"likeCount":104,"quoteCount":2,"indexedAt":"2026-11-20T16:41:14.447Z","labels":[],"threadgate":{"uri":"at://did:plc:x4rkbrazjqyyun5ysut2wq43/app.bsky.feed.threadgate/3n2qzot7mnc2b","cid":"bafyreiay4w5qo7xckbj3jlisorzuemurhsbnk45m7m4tyk5tcdingewo7q","record":{"$type":"app.bsky.feed.threadgate","allow":[{"$type":"app.bsky.feed.threadgate#followerRule"},{"$type":"app.bsky.feed.threadgate#mentionRule"}],"createdAt":"2