t regret over abandoning my PhD, I finally did the work to finish it, feeling briefly my greatest pride, just in time for the entire practice of human mathematics to shortly afterward come to an end and the PhD to lose all value."},"labels":[],"likeCount":383,"replyCount":14,"repostCount":10,"quoteCount":2,"opThreadPostIndex":1,"opThreadPostCount":3,"indexedAt":"2026-11-18T15:18:48.647Z","embeds":[],"$type":"app.bsky.embed.record#viewRecord"},"$type":"app.bsky.embed.record#view"},"bookmarkCount":10,"replyCount":9,"repostCount":13,"likeCount":138,"quoteCount":3,"indexedAt":"2026-11-20T15:27:05.853Z","labels":[]},"opThreadPostIndex":1,"opThreadPostCount":3,"feedContext":"trending-posts","reqId":"2879854280653500685"},{"post":{"uri":"at://did:plc:flxq4uyjfotciovpw3x3fxnu/app.bsky.feed.post/3n2qvqp4fts2e","cid":"bafyreif5ijypeavwxohhv4mfdg2jzyql2c5dahzumc5aoht3mcn3xtmdhe","author":{"did":"did:plc:flxq4uyjfotciovpw3x3fxnu","handle":"emollick.bsky.social","displayName":"Ethan Mollick","avatar":"https://cdn.bsky.app/img/avatar/plain/did:plc:flxq4uyjfotciovpw3x3fxnu/bafkreigq63ljumc43yx5eoxchrq75d72irea6ddcceedwmdttxebyowc3q","associated":{"chat":{"allowIncoming":"none"},"activitySubscription":{"allowSubscriptions":"followers"}},"labels":[],"createdAt":"2024-09-07T14:28:46.419Z","verification":{"verifications":[{"issuer":"did:plc:z72i7hdynmk6r22z27h6tvur","issuerDisplayName":"Bluesky","issuerHandle":"bsky.app","uri":"at://did:plc:z72i7hdynmk6r22z27h6tvur/app.bsky.graph.verification/3mqpbvcfwy422","isValid":true,"createdAt":"2026-07-15T17:50:45.436Z"}],"verifiedStatus":"valid","trustedVerifierStatus":"none"}},"record":{"$type":"app.bsky.feed.post","createdAt":"2026-11-20T15:30:42.096Z","embed":{"$type":"app.bsky.embed.images","images":[{"alt":"","aspectRatio":{"height":781,"width":1936},"image":{"$type":"blob","ref":{"$link":"bafkreih6amm3fu6356pcx6reb3tyfnouap4sysrbscbgzuitcb3fbrhm6m"},"mimeType":"image/jpeg","size":513621}}]},"facets":[{"features":[{"$type":"app.bsky.richtext.facet#link","uri":"https://alpo.ge/remark.pdf"}],"index":{"byteEnd":214,"byteStart":196}}],"langs":["en"],"text":"Riemann Hypothesis may have been solved with the help of Claude. “what I saw during the course of progress so amazed me that I believe it is one dawn across science of something\nfar greater.” alpo.ge/remark.pdf"},"embed":{"images":[{"thumb":"https://cdn.bsky.app/img/feed_thumbnail/plain/did:plc:flxq4uyjfotciovpw3x3fxnu/bafkreih6amm3fu6356pcx6reb3tyfnouap4sysrbscbgzuitcb3fbrhm6m","fullsize":"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:flxq4uyjfotciovpw3x3fxnu/bafkreih6amm3fu6356pcx6reb3tyfnouap4sysrbscbgzuitcb3fbrhm6m","alt":"","aspectRatio":{"height":781,"width":1936}}],"$type":"app.bsky.embed.images#view"},"bookmarkCount":12,"replyCount":10,"repostCount":20,"likeCount":104,"quoteCount":7,"indexedAt":"2026-11-20T15:30:52.944Z","labels":[]},"feedContext":"trending-posts","reqId":"2879854280653500685"},{"post":{"uri":"at://did:plc:myqic77tkmdhmaufgkvj43hr/app.bsky.feed.post/3n2qy2sqrj22z","cid":"bafyreic6rqrq5tkyab3fzki7b2lq7s3jgrxtyvdwdkfnsqmv4typ5bvwvm","author":{"did":"did:plc:myqic77tkmdhmaufgkvj43hr","handle":"kjhealy.co","displayName":"Kieran Healy","avatar":"https://cdn.bsky.app/img/avatar/plain/did:plc:myqic77tkmdhmaufgkvj43hr/bafkreig2gmg7g3ssdjjc4uehbdbbxazy5f75o4yc2geuxehrarodo7tyxm","associated":{"chat":{"allowIncoming":"following"},"activitySubscription":{"allowSubscriptions":"followers"}},"labels":[],"createdAt":"2023-05-01T10:43:11.484Z"},"record":{"$type":"app.bsky.feed.post","createdAt":"2026-11-20T16:12:08.941Z","langs":["en"],"text":"Why a Claude-assisted proof of the Riemann hypothesis accompanied by a 17-million-line Lean formalization means trouble for the Democrats"},"bookmarkCount":2,"replyCount":8,"repostCount":12,"likeCount":108,"quoteCount":2,"indexedAt":"2026-11-20T16:12:09.255Z","labels":[]},"feedContext":"trending-posts","reqId":"2879854280653500685"},{"post":{"uri":"at://did:plc:565ebob5f6hw33hjdkxty6qj/app.bsky.feed.post/3n2quhyesw226","cid":"bafyreid7izt4sp7klaq6qqpyupt3injakp4jadejrtcufddjwjbkd4eh5y","author":{"did":"did:plc:565ebob5f6hw33hjdkxty6qj","handle":"tedunderwood.com","displayName":"Ted Underwood","avatar":"https://cdn.bsky.app/img/avatar/plain/did:plc:565ebob5f6hw33hjdkxty6qj/bafkreics7dmvbnyn5hjc634kbx3il4pslrusu63g7ge26m5e3jrgrr45ju","associated":{"chat":{"allowIncoming":"all"},"activitySubscription":{"allowSubscriptions":"followers"}},"labels":[],"createdAt":"2023-04-10T04:40:50.288Z","verification":{"verifications":[{"issuer":"did:plc:z72i7hdynmk6r22z27h6tvur","issuerDisplayName":"Bluesky","issuerHandle":"bsky.app","uri":"at://did:plc:z72i7hdynmk6r22z27h6tvur/app.bsky.graph.verification/3mrxlkdv6yp2q","isValid":true,"createdAt":"2026-07-31T18:30:04.824Z"}],"verifiedStatus":"valid","trustedVerifierStatus":"none"}},"record":{"$type":"app.bsky.feed.post","createdAt":"2026-11-20T15:07:56.073Z","embed":{"$type":"app.bsky.embed.recordWithMedia","media":{"$type":"app.bsky.embed.images","images":[{"alt":"I believe I have, working with Claude, discovered a proof of the Riemann Hypothesis. In fact, the method easily extends much further, resolving the so-called Generalized Riemann Hypothesis, and I expect, with more time, the Extended Riemann Hypothesis too. Claude and I have also formalized the arguments without assumptions. It is natural to feel that this is an end, in my case a loss of a principal guiding light, but what I saw during the course of progress so amazed me that I believe it is one dawn across science of something tar greater.","aspectRatio":{"height":327,"width":1170},"image":{"$type":"blob","ref":{"$link":"bafkreifbhghdiojia3lsmuusexmmjqzajrydhay6jn36d6brmf6wklletm"},"mimeType":"image/jpeg","size":188063}}]},"record":{"$type":"app.bsky.embed.record","record":{"cid":"bafyreigjrrbnrwjg3wvj4gnfauvxfnvelidg4n7iyzx66hubm63pugabce","uri":"at://did:plc:o72ypk5c474zqklkukaphuy3/app.bsky.feed.post/3n2quaumvzk2v"}}},"langs":["en"],"text":"True or false, it’s quite a paragraph"},"embed":{"media":{"images":[{"thumb":"https://cdn.bsky.app/img/feed_thumbnail/plain/did:plc:565ebob5f6hw33hjdkxty6qj/bafkreifbhghdiojia3lsmuusexmmjqzajrydhay6jn36d6brmf6wklletm","fullsize":"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:565ebob5f6hw33hjdkxty6qj/bafkreifbhghdiojia3lsmuusexmmjqzajrydhay6jn36d6brmf6wklletm","alt":"I believe I have, working with Claude, discovered a proof of the Riemann Hypothesis. In fact, the method easily extends much further, resolving the so-called Generalized Riemann Hypothesis, and I expect, with more time, the Extended Riemann Hypothesis too. Claude and I have also formalized the arguments without assumptions. It is natural to feel that this is an end, in my case a loss of a principal guiding light, but what I saw during the course of progress so amazed me that I believe it is one dawn across science of something tar greater.","aspectRatio":{"height":327,"width":1170}}],"$type":"app.bsky.embed.images#view"},"record":{"record":{"uri":"at://did:plc:o72ypk5c474zqklkukaphuy3/app.bsky.feed.post/3n2quaumvzk2v","cid":"bafyreigjrrbnrwjg3wvj4gnfauvxfnvelidg4n7iyzx66hubm63pugabce","author":{"did":"did:plc:o72ypk5c474zqklkukaphuy3","handle":"zachweinersmith.bsky.social","displayName":"Zach Weinersmith","avatar":"https://cdn.bsky.app/img/avatar/plain/did:plc:o72ypk5c474zqklkukaphuy3/bafkreicpmyn2b25ed2atawbzv5uyfobknr63shjf6r4iudhvht2tzf5key","associated":{"chat":{"allowIncoming":"none","allowGroupInvites":"none"},"activitySubscription":{"allowSubscriptions":"followers"}},"labels":[],"createdAt":"2023-05-03T19:39:58.232Z","verification":{"verifications":[{"issuer":"did:plc:z72i7hdynmk6r22z27h6tvur","issuerDisplayName":"Bluesky","issuerHandle":"bsky.app","uri":"at://did:plc:z72i7hdynmk6r22z27h6tvur/app.bsky.graph.verification/3luxqk6bgog2p","isValid":true,"createdAt":"2025-07-27T18:48:50.471Z"}],"verifiedStatus":"valid","trustedVerifierStatus":"none"}},"value":{"$type":"app.bsky.feed.post","createdAt":"2026-11-20T1